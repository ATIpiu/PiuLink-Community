diff --git a/src/nvenc/piulink_content_rate.h b/src/nvenc/piulink_content_rate.h
new file mode 100644
index 0000000..bcb9826
--- /dev/null
+++ b/src/nvenc/piulink_content_rate.h
@@ -0,0 +1,98 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+
+namespace nvenc::piulink {
+  class content_rate_controller_t {
+  public:
+    void reset(uint32_t ceiling_kbps, uint32_t framerate) {
+      ceiling_kbps_ = current_kbps_ = ceiling_kbps;
+      framerate_ = std::max(1u, framerate);
+      quiet_frames_ = active_frames_ = quality_pressure_frames_ = cooldown_frames_ = 0;
+      ema_permille_ = 1000;
+      ema_output_kbps_ = ceiling_kbps;
+      ema_qp_x100_ = 0;
+      reduced_ = false;
+    }
+
+    void set_enabled(bool enabled) {
+      enabled_ = enabled;
+      quiet_frames_ = active_frames_ = quality_pressure_frames_ = cooldown_frames_ = 0;
+      reduced_ = false;
+    }
+
+    bool enabled() const { return enabled_; }
+    uint32_t ceiling_kbps() const { return ceiling_kbps_; }
+    uint32_t output_kbps() const { return static_cast<uint32_t>(ema_output_kbps_); }
+    uint32_t average_qp_x100() const { return static_cast<uint32_t>(ema_qp_x100_); }
+
+    void set_ceiling(uint32_t kbps) {
+      ceiling_kbps_ = current_kbps_ = kbps;
+      quiet_frames_ = active_frames_ = quality_pressure_frames_ = 0;
+      cooldown_frames_ = framerate_;
+      ema_output_kbps_ = kbps;
+      reduced_ = false;
+    }
+
+    void applied(uint32_t kbps) {
+      current_kbps_ = kbps;
+      reduced_ = kbps < ceiling_kbps_;
+    }
+
+    // frame_avg_qp is NVENC's actual per-frame average QP. A value of zero is
+    // treated as unavailable, keeping this controller compatible with traces.
+    std::optional<uint32_t> observe(std::size_t encoded_bytes, uint32_t frame_avg_qp, bool idr) {
+      if (!enabled_ || !ceiling_kbps_ || !current_kbps_ || idr) return std::nullopt;
+
+      const auto sample_kbps = std::min<uint64_t>(ceiling_kbps_ * 2ULL,
+        (uint64_t) encoded_bytes * 8 * framerate_ / 1000);
+      ema_output_kbps_ = (ema_output_kbps_ * 7 + sample_kbps) / 8;
+      const auto expected_bytes = std::max<uint64_t>(1, (uint64_t) current_kbps_ * 1000 / 8 / framerate_);
+      const auto sample_permille = std::min<uint64_t>(2000, (uint64_t) encoded_bytes * 1000 / expected_bytes);
+      ema_permille_ = (ema_permille_ * 7 + sample_permille) / 8;
+
+      if (frame_avg_qp) {
+        const auto qp = std::min<uint64_t>(5100, frame_avg_qp * 100ULL);
+        ema_qp_x100_ = ema_qp_x100_ ? (ema_qp_x100_ * 7 + qp) / 8 : qp;
+      }
+      if (cooldown_frames_) { --cooldown_frames_; return std::nullopt; }
+
+      const bool quality_pressure = ema_qp_x100_ >= 3600;
+      quality_pressure_frames_ = quality_pressure ? quality_pressure_frames_ + 1 : 0;
+      if (ema_permille_ <= 220 && !quality_pressure) {
+        ++quiet_frames_; active_frames_ = 0;
+      } else if (ema_permille_ >= 520) {
+        ++active_frames_; quiet_frames_ = 0;
+      } else {
+        quiet_frames_ = active_frames_ = 0;
+      }
+
+      if (!reduced_ && quiet_frames_ >= framerate_ * 5) {
+        quiet_frames_ = 0;
+        const auto safe_floor = std::max<uint32_t>(4000, ceiling_kbps_ * 60 / 100);
+        const auto demand = static_cast<uint32_t>(std::min<uint64_t>(ceiling_kbps_, ema_output_kbps_ * 125 / 100));
+        const auto target = std::clamp(demand, std::min(safe_floor, ceiling_kbps_), ceiling_kbps_);
+        const auto benefit = std::max<uint32_t>(1000, ceiling_kbps_ * 15 / 100);
+        if (current_kbps_ > target && current_kbps_ - target >= benefit) {
+          cooldown_frames_ = framerate_ * 2;
+          return target;
+        }
+      }
+      if (reduced_ && (active_frames_ >= 3 || quality_pressure_frames_ >= 2)) {
+        active_frames_ = quality_pressure_frames_ = 0;
+        cooldown_frames_ = framerate_;
+        return ceiling_kbps_;
+      }
+      return std::nullopt;
+    }
+
+  private:
+    bool enabled_ = false, reduced_ = false;
+    uint32_t ceiling_kbps_ = 0, current_kbps_ = 0, framerate_ = 60;
+    uint32_t quiet_frames_ = 0, active_frames_ = 0, quality_pressure_frames_ = 0, cooldown_frames_ = 0;
+    uint64_t ema_permille_ = 1000, ema_output_kbps_ = 0, ema_qp_x100_ = 0;
+  };
+}  // namespace nvenc::piulink
