+  void send_piulink_ack(session_t *session, uint32_t operation, uint32_t value) {
+    struct { control_header_v2 header; uint32_t operation; uint32_t value; } plaintext {};
+    plaintext.header.type = 0x55A1;
+    plaintext.header.payloadLength = 8;
+    plaintext.operation = util::endian::little(operation);
+    plaintext.value = util::endian::little(value);
+    std::array<std::uint8_t, sizeof(control_encrypted_t) + crypto::cipher::round_to_pkcs7_padded(sizeof(plaintext)) + crypto::cipher::tag_size> encrypted;
+    auto payload = encode_control(session, util::view(plaintext), encrypted);
+    if (session->control.peer) session->broadcast_ref->control_server.send(payload, session->control.peer);
+  }
+
   void controlBroadcastThread(control_server_t *server) {
+    server->map(0x55A0, [](session_t *session, const std::string_view &payload) {
+      if (payload.size() != 8 || session->config.controlProtocolType != 13) return;
+      uint32_t words[2];
+      std::memcpy(words, payload.data(), sizeof(words));
+      auto operation = util::endian::little(words[0]);
+      auto value = util::endian::little(words[1]);
+      if (operation == 0) send_piulink_ack(session, 0, 3);
+      else if (operation == 1) {
+        // Auto bitrate may grow beyond the initial budget, up to the protocol ceiling.
+        if (value < 500 || value > 150000) {
+          send_piulink_ack(session, 1, 0);
+          return;
+        }
+        session->mail->event<uint32_t>("piulink_bitrate")->raise(value);
+      } else if (operation == 2 && value <= 1) {
+        if (session::running_sessions != 1) { send_piulink_ack(session, 2, 0); return; }
+        if (value == 1 && !session->piulink_cursor_hidden) session->piulink_previous_cursor = display_cursor;
+        if (value == 1) display_cursor = false;
+        else if (session->piulink_cursor_hidden) display_cursor = session->piulink_previous_cursor;
+        session->piulink_cursor_hidden = value == 1;
+        send_piulink_ack(session, 2, value == 1 ? 1 : 2);
+      }
+    });
     server->map(packetTypes[IDX_PERIODIC_PING], [](session_t *session, const std::string_view &payload) {
       BOOST_LOG(verbose) << "type [IDX_PERIODIC_PING]"sv;
     });
