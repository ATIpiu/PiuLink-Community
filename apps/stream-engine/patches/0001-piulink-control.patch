+  bool nvenc_base::reconfigure_bitrate(uint32_t kbps) {
+    if (!encoder || kbps < 500 || kbps > 150000 || !saved_init.frameRateNum) return false;
+    auto candidate = saved_config;
+    auto old_rate = candidate.rcParams.averageBitRate;
+    candidate.rcParams.averageBitRate = kbps * 1000;
+    candidate.rcParams.maxBitRate = kbps * 1000;
+    if (old_rate && candidate.rcParams.vbvBufferSize)
+      candidate.rcParams.vbvBufferSize = (uint64_t) candidate.rcParams.vbvBufferSize * kbps * 1000 / old_rate;
+    NV_ENC_RECONFIGURE_PARAMS params {NV_ENC_RECONFIGURE_PARAMS_VER};
+    params.reInitEncodeParams = saved_init;
+    params.reInitEncodeParams.encodeConfig = &candidate;
+    // Reset rate-control state and make the first frame after reconfiguration an IDR.
+    // Without this, NVENC can accept the bitrate update but leave AV1/HEVC clients
+    // displaying the last pre-reconfiguration frame indefinitely.
+    params.resetEncoder = 1;
+    params.forceIDR = 1;
+    // Called only by the encoding thread between frames. No encoder teardown or reconnect.
+    if (nvenc_failed(nvenc->nvEncReconfigureEncoder(encoder, &params))) return false;
+    saved_config = candidate;
+    BOOST_LOG(info) << "PiuLink live bitrate applied: " << kbps << " Kbps";
+    return true;
+  }
