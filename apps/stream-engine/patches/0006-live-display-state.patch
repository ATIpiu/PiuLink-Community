+  void getPiuLinkState(const resp_https_t &response, const req_https_t &request) {
+    if (!authenticate(response, request)) return;
+    const auto devices = display_device::enumerate_devices();
+    nlohmann::json state;
+    state["activeStreams"] = rtsp_stream::session_count();
+    state["currentApplicationId"] = proc::proc.running();
+    state["displays"] = nlohmann::json::parse(display_device::toJson(devices));
+    state["observedAt"] = std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::system_clock::now().time_since_epoch()).count();
+    response->write(SimpleWeb::StatusCode::success_ok, state.dump(),
+      {{"Content-Type", "application/json"}, {"Cache-Control", "no-store"}});
+  }
