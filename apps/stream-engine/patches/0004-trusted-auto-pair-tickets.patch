+  static bool is_tailnet_address(const boost::asio::ip::address &address) {
+    auto normalized = net::normalize_address(address);
+    if (normalized.is_v4()) {
+      static const auto tailnet_v4 = boost::asio::ip::make_network_v4("100.64.0.0/10"sv);
+      return tailnet_v4.hosts().find(normalized.to_v4()) != tailnet_v4.hosts().end();
+    }
+
+    // Tailscale's stable IPv6 allocation prefix. Link-local and other ULA addresses remain LAN.
+    static const auto tailnet_v6 = boost::asio::ip::make_network_v6("fd7a:115c:a1e0::/48"sv);
+    return tailnet_v6.hosts().find(normalized.to_v6()) != tailnet_v6.hosts().end();
+  }
+
+  static bool trusted_auto_pair_enabled(const boost::asio::ip::address &address) {
+    if (is_tailnet_address(address)) {
+      return config::nvhttp.piulink_auto_pair_tailnet;
+    }
+
+    const auto scope = net::from_address(net::addr_to_normalized_string(address));
+    return config::nvhttp.piulink_auto_pair_lan &&
+           (scope == net::net_e::PC || scope == net::net_e::LAN);
+  }
