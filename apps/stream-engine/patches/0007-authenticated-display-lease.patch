+  void preparePiuLinkDisplay(const resp_https_t &response, const req_https_t &request) {
+    if (!authenticate(response, request)) return;
+    if (!request->remote_endpoint().address().is_loopback()) { bad_request(response, request, "Local control only"); return; }
+    try {
+      const auto input = nlohmann::json::parse(request->content.string());
+      const auto id = input.at("requestId").get<std::string>();
+      const auto owner = input.at("owner").get<std::string>();
+      if (id.size() != 36 || owner.size() != 64 || rtsp_stream::session_count() != 0)
+        throw std::invalid_argument("Invalid or busy display lease");
+      if (input.value("action", "") == "abort") nvhttp::revoke_display_lease(id, owner);
+      else nvhttp::register_display_lease(id, owner, input.value("mode", ""), input.value("ready", false));
+      send_response(response, nlohmann::json {{"status", true}});
+    } catch (const std::exception &error) { bad_request(response, request, error.what()); }
+  }
