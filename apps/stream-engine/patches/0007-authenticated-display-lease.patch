+  static void persist_display_lease() {
+    const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(display_lease_expires - std::chrono::steady_clock::now()).count();
+    const auto expires = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count() + remaining;
+    const nlohmann::json entry {{"id", display_lease_id}, {"owner", display_lease_owner}, {"mode", display_lease_mode},
+      {"ready", display_lease_ready}, {"expires", expires}};
+    const std::filesystem::path path {config::nvhttp.file_state + ".display-lease"};
+    const std::filesystem::path temporary {path.string() + ".tmp"};
+    if (file_handler::write_file(temporary.string().c_str(), entry.dump()) != 0)
+      throw std::runtime_error("Cannot persist display lease");
+#ifdef _WIN32
+    if (!MoveFileExW(temporary.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH))
+      throw std::runtime_error("Cannot commit display lease");
+#else
+    std::filesystem::rename(temporary, path);
+#endif
+  }
+
+  static void load_display_lease() {
+    try {
+      const auto entry = nlohmann::json::parse(file_handler::read_file((config::nvhttp.file_state + ".display-lease").c_str()));
+      const auto remaining = entry.at("expires").get<int64_t>() -
+        std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+      if (remaining <= 0 || remaining > 120000) return;
+      display_lease_id = entry.at("id"); display_lease_owner = entry.at("owner"); display_lease_mode = entry.at("mode");
+      display_lease_ready = entry.at("ready");
+      display_lease_expires = std::chrono::steady_clock::now() + std::chrono::milliseconds(remaining);
+    } catch (const std::exception &) { }
+  }
+
+  void register_display_lease(const std::string &request_id, const std::string &owner, const std::string &mode, bool ready) {
+    std::lock_guard lock {display_lease_mutex};
+    if (rtsp_stream::session_count() != 0 || (std::chrono::steady_clock::now() < display_lease_expires &&
+        !display_lease_id.empty() && (display_lease_id != request_id || display_lease_owner != owner)))
+      throw std::invalid_argument("Another display session is active or preparing");
+    const bool same_lease = display_lease_id == request_id && display_lease_owner == owner;
+    display_lease_id = request_id; display_lease_owner = owner;
+    display_lease_mode = mode; display_lease_ready = ready;
+    if (!ready || !same_lease) display_lease_expires = std::chrono::steady_clock::now() + std::chrono::seconds(45);
+    persist_display_lease();
+  }
+
+  void revoke_display_lease(const std::string &request_id, const std::string &owner) {
+    std::lock_guard lock {display_lease_mutex};
+    if (display_lease_id == request_id && display_lease_owner == owner) {
+      display_lease_expires = std::chrono::steady_clock::now(); display_lease_id.clear(); display_lease_ready = false;
+      persist_display_lease();
+    }
+  }
+
+  static bool valid_display_lease(const std::string &id, const std::string &owner, const std::string &mode) {
+    return display_lease_ready && !id.empty() && !owner.empty() && id == display_lease_id && owner == display_lease_owner &&
+      (display_lease_mode.empty() || mode == display_lease_mode) &&
+      std::chrono::steady_clock::now() < display_lease_expires;
+  }
