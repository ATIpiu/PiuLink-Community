 #include <string>
 
 namespace video {
+  // A request completes only when the encoder has emitted a keyframe for that generation.
+  class live_resolution_t {
+    std::mutex mutex;
+    std::condition_variable changed;
+    int width = 0, height = 0, encoded_width = 0, encoded_height = 0;
+    unsigned encoded_generation = 0;
+  public:
+    std::atomic_uint generation {0};
+
+    unsigned configure(int &w, int &h) {
+      std::lock_guard lock {mutex};
+      if (!width) { width = w; height = h; }
+      w = width;
+      h = height;
+      return generation.load();
+    }
+    void encoded(unsigned version, int w, int h) {
+      std::lock_guard lock {mutex};
+      if (generation != version || width != w || height != h) return;
+      encoded_width = w;
+      encoded_height = h;
+      encoded_generation = version;
+      changed.notify_all();
+    }
+    bool rollback(unsigned version) {
+      std::lock_guard lock {mutex};
+      if (version != generation || !encoded_width || (width == encoded_width && height == encoded_height)) return false;
+      width = encoded_width;
+      height = encoded_height;
+      ++generation;
+      changed.notify_all();
+      return true;
+    }
+    bool current(int &w, int &h) {
+      std::lock_guard lock {mutex};
+      w = encoded_width;
+      h = encoded_height;
+      return w > 0 && h > 0;
+    }
+    bool resize(int w, int h) {
+      std::unique_lock lock {mutex};
+      if (!encoded_width) return false;
+      if (encoded_generation == generation && encoded_width == w && encoded_height == h) return true;
+      width = w;
+      height = h;
+      const unsigned requested = ++generation;
+      changed.wait_for(lock, std::chrono::seconds(5), [&] {
+        return requested != generation || encoded_generation == requested;
+      });
+      if (generation != requested) return false;
+      if (encoded_generation == requested) return true;
+      width = encoded_width;
+      height = encoded_height;
+      ++generation;
+      return false;
+    }
+  };
+
