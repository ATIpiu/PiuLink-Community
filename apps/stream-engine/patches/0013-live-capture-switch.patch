diff --git a/src/live_capture.h b/src/live_capture.h
new file mode 100644
index 00000000..0b92e629
--- /dev/null
+++ b/src/live_capture.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <string>
+
+namespace video {
+  // Owned by one authenticated launch and its capture thread. Other streams never share it.
+  class live_capture_t {
+    std::mutex mutex;
+    std::condition_variable changed;
+    std::string desired, opened;
+    bool initialized = false;
+  public:
+    std::atomic_bool pending {false};
+    explicit live_capture_t(const std::string &initial): desired(initial) {}
+    std::string target() {
+      std::lock_guard lock {mutex};
+      return desired;
+    }
+    void captured(const std::string &output) {
+      std::lock_guard lock {mutex};
+      opened = output;
+      initialized = true;
+      pending = desired != opened;
+      changed.notify_all();
+    }
+    bool reject(const std::string &output) {
+      std::lock_guard lock {mutex};
+      if (!initialized || opened == output) return false;
+      if (desired == output) desired = opened;
+      pending = true;
+      changed.notify_all();
+      return true;
+    }
+    bool select(const std::string &output) {
+      std::unique_lock lock {mutex};
+      if (!initialized || pending) return false;
+      if (output == opened) return true;
+      desired = output;
+      pending = true;
+      changed.wait_for(lock, std::chrono::seconds(4), [&] { return opened == output || desired != output; });
+      if (opened == output) return true;
+      if (desired != output) return false;  // The capture thread has already started recovery.
+      desired = opened;
+      pending = true;
+      return false;
+    }
+  };
+}
