+    NSMutableArray* result = [NSMutableArray array];
+    for (NSString* ip in ips) {
+        if (![ip isKindOfClass:NSString.class]) continue;
+        struct in_addr v4;
+        struct in6_addr v6;
+        if (inet_pton(AF_INET, ip.UTF8String, &v4) == 1) {
+            uint32_t n = ntohl(v4.s_addr);
