 {
     private:
+        PiuLinkPcmQueue m_audio;
+        KSPIN_LOCK m_audioLock;
         PSERVICEGROUP           m_pServiceGroupWave;
         PDEVICE_OBJECT          m_pDeviceObject;
         PDEVICE_OBJECT          m_pPhysicalDeviceObject;
@@ -53,6 +56,9 @@ class CAdapterCommon :
 
     public:
         //=====================================================================
+        STDMETHODIMP_(void) TransferMicrophone(BOOLEAN capture, PBYTE data, ULONG bytes);
+        STDMETHODIMP_(void) ResetMicrophone();
+
         // Default CUnknown
         DECLARE_STD_UNKNOWN();
         DEFINE_STD_CONSTRUCTOR(CAdapterCommon);
@@ -562,6 +568,8 @@ Return Value:
     NTSTATUS        ntStatus    = STATUS_SUCCESS;
 
     m_pServiceGroupWave     = NULL;
+    KeInitializeSpinLock(&m_audioLock);
+    m_audio.Clear();
     m_pDeviceObject         = DeviceObject;
     m_pPhysicalDeviceObject = NULL;
     m_WdfDevice             = NULL;
@@ -2775,3 +2783,23 @@ Exit:
 
     return ntStatus;
 }
+
+#pragma code_seg()
+STDMETHODIMP_(void) CAdapterCommon::ResetMicrophone()
+{
+    KIRQL irql;
+    KeAcquireSpinLock(&m_audioLock, &irql);
+    m_audio.Clear();
+    KeReleaseSpinLock(&m_audioLock, irql);
+}
+
+STDMETHODIMP_(void) CAdapterCommon::TransferMicrophone(BOOLEAN capture, PBYTE data, ULONG bytes)
+{
+    KIRQL irql;
+    KeAcquireSpinLock(&m_audioLock, &irql);
+    ULONG used = 0;
+    if (capture) used = m_audio.Read(data, bytes);
+    else m_audio.Write(data, bytes);
+    KeReleaseSpinLock(&m_audioLock, irql);
+    if (capture) RtlZeroMemory(data + used, bytes - used);
+}
