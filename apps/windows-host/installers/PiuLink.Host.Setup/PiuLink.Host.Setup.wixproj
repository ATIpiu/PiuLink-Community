<Project Sdk="WixToolset.Sdk/6.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>PiuLink.Host.Setup</OutputName>
    <HostProject>$(MSBuildThisFileDirectory)..\..\src\PiuLink.Host\PiuLink.Host.csproj</HostProject>
    <HostCliProject>$(MSBuildThisFileDirectory)..\..\src\PiuLink.Host.Cli\PiuLink.Host.Cli.csproj</HostCliProject>
    <PublishDirectory>$(MSBuildThisFileDirectory)..\staging\PiuLink.Host</PublishDirectory>
    <PiuLinkMicrophonePackage Condition="'$(PiuLinkMicrophonePackage)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\artifacts\PiuLinkMic-signed-x64</PiuLinkMicrophonePackage>
    <MicrophoneLayoutTest Condition="'$(MicrophoneLayoutTest)' == ''">0</MicrophoneLayoutTest>
    <DotNetExecutable>$(ProgramW6432)\dotnet\dotnet.exe</DotNetExecutable>
    <PiuLinkSelfContained Condition="'$(PiuLinkSelfContained)' == ''">true</PiuLinkSelfContained>
    <PiuLinkEngineDirectory Condition="'$(PiuLinkEngineDirectory)' == ''"></PiuLinkEngineDirectory>
    <PiuLinkShareSigningCertificateThumbprint Condition="'$(PiuLinkShareSigningCertificateThumbprint)' == ''"></PiuLinkShareSigningCertificateThumbprint>
    <PiuLinkSharePublisher Condition="'$(PiuLinkSharePublisher)' == ''"></PiuLinkSharePublisher>
    <PiuLinkPrebuiltShareDirectory Condition="'$(PiuLinkPrebuiltShareDirectory)' == ''"></PiuLinkPrebuiltShareDirectory>
    <ShareBuildDirectory>$(MSBuildThisFileDirectory)..\staging\PiuLink.Share</ShareBuildDirectory>
    <DefineConstants>PublishDir=$(PublishDirectory)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Firewall.wixext" Version="6.0.0" />
  </ItemGroup>

  <Target Name="PublishPiuLinkHost" BeforeTargets="BeforeBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\Generate-UninstallAction.ps1&quot; -OutputPath &quot;$(MSBuildThisFileDirectory)obj\SunshineRemoval.wxi&quot;" />
    <XmlPeek XmlInputPath="$(HostProject)" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="HostVersion" />
    </XmlPeek>
    <PropertyGroup>
      <EmbeddedEngine>0</EmbeddedEngine>
      <EmbeddedEngine Condition="'$(PiuLinkEngineDirectory)' != ''">1</EmbeddedEngine>
      <ShareEnabled>0</ShareEnabled>
      <ShareEnabled Condition="'$(PiuLinkShareSigningCertificateThumbprint)' != '' Or '$(PiuLinkPrebuiltShareDirectory)' != ''">1</ShareEnabled>
      <EnginePublishArgument Condition="'$(PiuLinkEngineDirectory)' != ''">-p:PiuLinkEngineDirectory=&quot;$(PiuLinkEngineDirectory)&quot;</EnginePublishArgument>
      <DefineConstants>PublishDir=$(PublishDirectory);HostVersion=$(HostVersion);EmbeddedEngine=$(EmbeddedEngine);ShareEnabled=$(ShareEnabled);MicrophoneLayoutTest=$(MicrophoneLayoutTest);LocalMicComputer=$(LocalMicComputer)</DefineConstants>
      <LayoutArgument Condition="'$(MicrophoneLayoutTest)' == '1'">-LayoutTest</LayoutArgument>
    </PropertyGroup>
    <RemoveDir Directories="$(PublishDirectory)" />
    <Exec Command="&quot;$(DotNetExecutable)&quot; publish &quot;$(HostProject)&quot; -c Release -r win-x64 --self-contained $(PiuLinkSelfContained) -p:PublishSingleFile=false -p:DebugType=None -p:DebugSymbols=false $(EnginePublishArgument) -o &quot;$(PublishDirectory)&quot;" />
    <Exec Command="&quot;$(DotNetExecutable)&quot; publish &quot;$(HostCliProject)&quot; -c Release -r win-x64 --self-contained $(PiuLinkSelfContained) -p:PublishSingleFile=false -p:DebugType=None -p:DebugSymbols=false -o &quot;$(PublishDirectory)&quot;" />
    <Exec Condition="'$(LocalMicComputer)' == ''" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\audio-driver\Stage-Driver.ps1&quot; -PackageDirectory &quot;$(PiuLinkMicrophonePackage)&quot; -PublishDirectory &quot;$(PublishDirectory)&quot; $(LayoutArgument)" />
    <RemoveDir Directories="$(ShareBuildDirectory)" Condition="'$(ShareEnabled)' == '1'" />
    <Exec Condition="'$(PiuLinkShareSigningCertificateThumbprint)' != ''" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\share\Build-ShareTarget.ps1&quot; -SigningCertificateThumbprint &quot;$(PiuLinkShareSigningCertificateThumbprint)&quot; -SigningCertificateSubject &quot;$(PiuLinkSharePublisher)&quot; -OutputDirectory &quot;$(ShareBuildDirectory)&quot; -SelfContained &quot;$(PiuLinkSelfContained)&quot;" />
    <Exec Condition="'$(PiuLinkPrebuiltShareDirectory)' != ''" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;Copy-Item -LiteralPath '$(PiuLinkPrebuiltShareDirectory)\PiuLink.Share.msix' -Destination '$(PublishDirectory)\PiuLink.Share.msix' -Force; Copy-Item -LiteralPath '$(PiuLinkPrebuiltShareDirectory)\ShareTarget' -Destination '$(PublishDirectory)\ShareTarget' -Recurse -Force&quot;" />
    <Exec Condition="'$(PiuLinkShareSigningCertificateThumbprint)' != ''" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;Copy-Item -LiteralPath '$(ShareBuildDirectory)\PiuLink.Share.msix' -Destination '$(PublishDirectory)\PiuLink.Share.msix' -Force; Copy-Item -LiteralPath '$(ShareBuildDirectory)\ShareTarget' -Destination '$(PublishDirectory)\ShareTarget' -Recurse -Force&quot;" />
    <Copy Condition="'$(ShareEnabled)' == '1'" SourceFiles="$(MSBuildThisFileDirectory)..\share\Register-ShareTarget.ps1" DestinationFolder="$(PublishDirectory)" />
  </Target>
</Project>
