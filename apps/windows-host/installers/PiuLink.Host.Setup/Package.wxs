<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:firewall="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <?include obj\SunshineRemoval.wxi ?>
  <Package Id="ATIPiuLabs.PiuLink.Host"
           Name="PiuLink Host"
           Manufacturer="ATIPiu Labs"
           Version="$(var.HostVersion)"
           Scope="perMachine">
    <?if "$(var.LocalMicComputer)" != "" ?>
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of PiuLink Host is already installed." />
    <Property Id="PIULINK_LOCAL_MIC_SERVICE">
      <RegistrySearch Id="LocalBoundMicrophone" Root="HKLM" Key="SYSTEM\CurrentControlSet\Enum\ROOT\PIULINKVIRTUALMICROPHONE\0000" Name="Service" Type="raw" />
    </Property>
    <Launch Condition='Installed OR (WIX_UPGRADE_DETECTED AND ComputerName ~= "$(var.LocalMicComputer)" AND PIULINK_LOCAL_MIC_SERVICE ~= "SteamStreamingMicrophone")' Message="This local development upgrade requires the existing PiuLink Host and bound microphone on the original computer." />
    <?else?>
    <MajorUpgrade DowngradeErrorMessage="A newer version of PiuLink Host is already installed." />
    <?endif?>
    <MediaTemplate EmbedCab="yes" />
    <?if $(var.MicrophoneLayoutTest) = 1 ?>
    <Launch Condition="Installed" Message="Packaging validation only. Obtain the Windows-signed microphone package before installation." />
    <?endif?>
    <?if "$(var.LocalMicComputer)" = "" ?>
    <CustomAction Id="InstallBundledMicrophone" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]PiuLink.Host.exe&quot; --msi-install-microphone [ProductCode]" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackBundledMicrophone" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]PiuLink.Host.exe&quot; --msi-rollback-microphone [ProductCode]" Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="CommitBundledMicrophone" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]PiuLink.Host.exe&quot; --msi-commit-microphone [ProductCode]" Execute="commit" Impersonate="no" Return="check" />
    <?endif?>
    <Property Id="SunshineRemovalCommand" Value="$(var.SunshineRemovalCommand)" Hidden="yes" />
    <?if "$(var.LocalMicComputer)" = "" ?>
    <CustomAction Id="RemoveOwnedMicrophoneDevice" Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]pnputil.exe&quot; /remove-device &quot;ROOT\PIULINKVIRTUALMICROPHONE\0000&quot;"
                  Execute="commit" Impersonate="no" Return="ignore" />
    <?endif?>
    <CustomAction Id="RemoveStandaloneSunshineOnUninstall" Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -EncodedCommand [SunshineRemovalCommand]"
                  Execute="commit" Impersonate="no" Return="check" />
    <?if $(var.ShareEnabled) = 1 ?>
    <CustomAction Id="RegisterPiuLinkShareTarget" Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]Register-ShareTarget.ps1&quot; -Action Register"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="UnregisterPiuLinkShareTarget" Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]Register-ShareTarget.ps1&quot; -Action Unregister"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <?endif?>
    <InstallExecuteSequence>
      <?if "$(var.LocalMicComputer)" = "" ?>
      <Custom Action="RollbackBundledMicrophone" After="InstallFiles" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="InstallBundledMicrophone" After="RollbackBundledMicrophone" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="CommitBundledMicrophone" After="InstallBundledMicrophone" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="RemoveOwnedMicrophoneDevice" Before="InstallFinalize"
              Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <?endif?>
      <?if $(var.ShareEnabled) = 1 ?>
      <Custom Action="RegisterPiuLinkShareTarget" After="InstallFiles" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="UnregisterPiuLinkShareTarget" Before="RemoveFiles" Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <?endif?>
      <Custom Action="RemoveStandaloneSunshineOnUninstall" Before="InstallFinalize"
              Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <?if $(var.EmbeddedEngine) = 1 ?>
    <Property Id="EXISTING_STREAM_SERVICE">
      <RegistrySearch Id="ExistingStreamService" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\SunshineService" Name="ImagePath" Type="raw" />
    </Property>
    <Launch Condition="NOT EXISTING_STREAM_SERVICE OR Installed OR WIX_UPGRADE_DETECTED" Message="An existing Sunshine service must be migrated before installing the integrated PiuLink engine. Its configuration has not been changed." />
    <?endif?>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="CompanyFolder" Name="ATIPiu Labs">
        <Directory Id="INSTALLFOLDER" Name="PiuLink Host">
          <Files Include="$(var.PublishDir)\**">
            <Exclude Files="$(var.PublishDir)\**\*.pdb" />
            <?if $(var.EmbeddedEngine) = 1 ?>
            <Exclude Files="$(var.PublishDir)\engine\tools\sunshinesvc.exe" />
            <?endif?>
          </Files>
          <?if $(var.EmbeddedEngine) = 1 ?>
          <Directory Id="ENGINEFOLDER" Name="engine">
            <Directory Id="ENGINETOOLSFOLDER" Name="tools">
              <Component Id="PiuLinkStreamServiceComponent" Guid="7F0CD44D-EBC1-4579-B74A-924F42F25C81">
                <File Id="PiuLinkStreamServiceBinary" Source="$(var.PublishDir)\engine\tools\sunshinesvc.exe" KeyPath="yes" />
                <ServiceInstall Id="PiuLinkStreamServiceInstall" Name="SunshineService" DisplayName="PiuLink Streaming Engine" Description="PiuLink managed desktop streaming engine, based on Sunshine." Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" />
                <ServiceControl Id="PiuLinkStreamServiceControl" Name="SunshineService" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
                <firewall:FirewallException Id="EnginePairingTls" Name="PiuLink stream pairing TLS" Program="[ENGINEFOLDER]sunshine.exe" Port="47984" Protocol="tcp" Profile="all" Scope="any" />
                <firewall:FirewallException Id="EngineDiscovery" Name="PiuLink stream discovery" Program="[ENGINEFOLDER]sunshine.exe" Port="47989" Protocol="tcp" Profile="all" Scope="any" />
                <firewall:FirewallException Id="EngineMdnsDiscovery" Name="PiuLink local network discovery" Program="[ENGINEFOLDER]sunshine.exe" Port="5353" Protocol="udp" Profile="all" Scope="localSubnet" />
                <firewall:FirewallException Id="EngineSession" Name="PiuLink stream session" Program="[ENGINEFOLDER]sunshine.exe" Port="48010" Protocol="tcp" Profile="all" Scope="any" />
                <firewall:FirewallException Id="EngineVideo" Name="PiuLink video" Program="[ENGINEFOLDER]sunshine.exe" Port="47998" Protocol="udp" Profile="all" Scope="any" />
                <firewall:FirewallException Id="EngineControl" Name="PiuLink stream control" Program="[ENGINEFOLDER]sunshine.exe" Port="47999" Protocol="udp" Profile="all" Scope="any" />
                <firewall:FirewallException Id="EngineAudio" Name="PiuLink audio" Program="[ENGINEFOLDER]sunshine.exe" Port="48000" Protocol="udp" Profile="all" Scope="any" />
                <firewall:FirewallException Id="EngineMicrophone" Name="PiuLink microphone" Program="[ENGINEFOLDER]sunshine.exe" Port="48002" Protocol="udp" Profile="all" Scope="any" />
              </Component>
            </Directory>
          </Directory>
          <?endif?>
          <Component Id="PiuLinkDisplayCompanionFirewall" Guid="EAC7BD67-C084-43DF-88F2-C20D711C2C80">
            <firewall:FirewallException Id="DisplayCompanionFirewallException"
                                        Name="PiuLink display discovery"
                                        Program="[INSTALLFOLDER]PiuLink.Host.exe"
                                        Port="48011"
                                        Protocol="tcp"
                                        Profile="all"
                                        Scope="any" />
            <firewall:FirewallException Id="FileTransferFirewallException"
                                        Name="PiuLink file transfer"
                                        Program="[INSTALLFOLDER]PiuLink.Host.exe"
                                        Port="48012"
                                        Protocol="tcp"
                                        Profile="all"
                                        Scope="any" />
            <RegistryValue Root="HKLM"
                           Key="Software\ATIPiu Labs\PiuLink Host"
                           Name="DisplayCompanionFirewall"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PiuLinkProgramMenuFolder" Name="PiuLink">
        <Component Id="PiuLinkStartMenuShortcut" Guid="D8F74E53-B81A-4528-A6F5-FF6543C51877">
          <Shortcut Id="PiuLinkHostShortcut"
                    Name="PiuLink Host"
                    Description="Manage remote streaming on this PC"
                    Target="[INSTALLFOLDER]PiuLink.Host.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemovePiuLinkProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\ATIPiu Labs\PiuLink Host"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
