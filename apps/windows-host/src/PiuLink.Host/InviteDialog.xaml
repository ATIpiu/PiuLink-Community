<Window x:Class="PiuLink.Host.InviteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PiuLink.Host"
        Width="540" MinWidth="360" SizeToContent="Height" ResizeMode="CanResize"
        Icon="Assets/PiuLink.ico" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource BodyMutedStyle}">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>
  <Grid Background="{StaticResource BackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,22,24,18">
        <DockPanel Margin="0,0,0,16">
          <Border x:Name="HeaderIconPanel" Width="40" Height="40" CornerRadius="11"
                  Background="{Binding PlateBrush, ElementName=HeaderIcon}" Margin="0,0,12,0">
            <local:HostArtwork x:Name="HeaderIcon" Symbol="Invitation" Width="25" Height="25"/>
          </Border>
          <TextBlock x:Name="HeadingText" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                     FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel x:Name="WarningSection" Visibility="Collapsed">
          <Border Background="{StaticResource WarningFillBrush}" CornerRadius="10" Padding="14,12">
            <StackPanel>
              <TextBlock Text="只发给你信任的人" Foreground="{StaticResource WarningBrush}" Style="{StaticResource Heading}"/>
              <TextBlock Text="拿到链接的人可以查询主机地址并请求连接。新设备需要你在 Host 确认，已配对的设备可以免输密码再次连接。"
                         Style="{StaticResource Hint}" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock Text="本次使用的打洞服务" Style="{StaticResource Heading}" Margin="0,18,0,4"/>
          <TextBlock x:Name="ServiceSummary" TextWrapping="Wrap"/>
          <TextBlock Text="服务可看到两端网络地址。画面、声音和输入直接在设备之间传输。"
                     Style="{StaticResource Hint}" Margin="0,4,0,0"/>
          <TextBlock Text="关闭邀请会结束当前邀请连接。要撤销已配对设备的权限，请在 Host 中移除该设备。"
                     Style="{StaticResource Hint}" Margin="0,12,0,0"/>
        </StackPanel>

        <StackPanel x:Name="SettingsSection" Visibility="Collapsed">
          <TextBlock Text="打洞服务" Style="{StaticResource Heading}"/>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,9">
            <RadioButton x:Name="Official" Content="官方服务" GroupName="Provider" Margin="0,0,22,0"
                         Foreground="{StaticResource TextBrush}" Checked="ProviderChanged"/>
            <RadioButton x:Name="Custom" Content="自建服务" GroupName="Provider"
                         Foreground="{StaticResource TextBrush}" Checked="ProviderChanged"/>
          </StackPanel>
          <TextBox x:Name="ServiceAddress" AutomationProperties.Name="打洞服务 HTTPS 地址" MinHeight="35"
                   TextChanged="ServiceEdited"/>
          <TextBlock x:Name="ServiceHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
        </StackPanel>

        <TextBlock x:Name="GuideLine" Style="{StaticResource Hint}" Margin="0,12,0,0">
          <Run x:Name="GuideIntro"/><Hyperlink x:Name="DeploymentGuide" NavigateUri="{x:Static local:InviteDialog.GuideUrl}"
              Foreground="{StaticResource TextBrush}" RequestNavigate="OpenGuide"
              ToolTip="在浏览器中打开 GitHub 部署说明" AutomationProperties.Name="自建服务指南">自建服务指南 ↗</Hyperlink>
        </TextBlock>

        <StackPanel x:Name="HistorySection" Visibility="Collapsed">
          <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,18,0,15"/>
          <DockPanel>
            <TextBlock x:Name="HistoryCount" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="邀请历史" Style="{StaticResource Heading}"/>
          </DockPanel>
          <TextBlock x:Name="EmptyHistory" Text="还没有邀请记录。生成的链接会加密保存在这台电脑上，最多保留 20 条。"
                     Style="{StaticResource Hint}" Margin="0,8,0,0"/>
          <ListBox x:Name="History" MaxHeight="180" Margin="0,8,0,0" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="邀请历史"
                   SelectionChanged="HistorySelected">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Row" Padding="10,7" CornerRadius="7" Margin="0,1" Background="{StaticResource PanelBrush}"
                          BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource RaisedPanelBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource ControlBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><DockPanel>
              <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="{Binding State}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
              <StackPanel><TextBlock Text="{Binding Authority}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Date}" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            </DockPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel x:Name="HistoryActions" Margin="0,8,0,0">
            <Button x:Name="Copy" Content="复制所选链接" Click="CopyHistory" Padding="10,5" Margin="0,0,6,0" IsEnabled="False"/>
            <Button x:Name="Clear" Content="清空历史…" Click="ConfirmClear" Padding="10,5"/>
          </WrapPanel>
          <StackPanel x:Name="ClearPrompt" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="清空本机邀请记录？当前邀请仍可使用。" Style="{StaticResource Hint}"/>
            <WrapPanel Margin="0,6,0,0"><Button Content="保留记录" Click="KeepHistory" Padding="10,5" Margin="0,0,6,0"/>
              <Button Content="确认清空" Click="ClearHistory" Style="{StaticResource DangerButton}" Padding="10,5"/></WrapPanel>
          </StackPanel>
          <TextBox x:Name="CopyFallback" Visibility="Collapsed" IsReadOnly="True" IsUndoEnabled="False" Margin="0,8,0,0"
                   AutomationProperties.Name="所选邀请链接"/>
        </StackPanel>
        <TextBlock x:Name="Feedback" Visibility="Collapsed" Style="{StaticResource Hint}" FontSize="13" Margin="0,10,0,0"
                   AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,12"
            Background="{StaticResource SidebarBrush}">
      <WrapPanel HorizontalAlignment="Right">
        <Button x:Name="CancelAction" IsCancel="True" Content="取消" MinWidth="76" Margin="0,0,8,0"/>
        <Button x:Name="PrimaryAction" Click="Apply" Style="{StaticResource PrimaryButtonStyle}" MinWidth="100"/>
      </WrapPanel>
    </Border>
  </Grid>
</Window>
