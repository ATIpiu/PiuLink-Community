<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>PiuLink.Host</AssemblyName>
    <RootNamespace>PiuLink.Host</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns startup; no WinForms ApplicationConfiguration.Initialize is called.
         Establish DPI awareness in the manifest before WPF creates any HWND. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationIcon>Assets\PiuLink.ico</ApplicationIcon>
    <Version>0.2.143</Version>
    <Authors>Ryan</Authors>
    <Company>ATIPiu Labs</Company>
    <Product>PiuLink Host</Product>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../packages/updates/ReleaseDownload.cs" Link="Updates/ReleaseDownload.cs" />
    <Compile Include="../../../../packages/updates/WindowsUpdateDialog.cs" Link="Updates/WindowsUpdateDialog.cs" />
    <Compile Include="../../../../packages/windows-ui/UpdateRestart.cs" Link="Updates/UpdateRestart.cs" />
    <Compile Include="../../../../packages/windows-ui/DesktopClipboard.cs" Link="Services/DesktopClipboard.cs" />
    <Compile Include="..\..\..\..\packages\windows-ui\WindowChrome.cs" Link="Themes\WindowChrome.cs" />
    <Page Include="..\..\..\..\packages\windows-ui\PiuLinkTheme.xaml" Link="Themes\PiuLinkTheme.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <ProjectReference Include="..\PiuLink.Host.Core\PiuLink.Host.Core.csproj" />
    <Compile Include="../../../../packages/rendezvous/*.cs" Link="Rendezvous/%(Filename)%(Extension)" />
    <!-- Preserve the production endpoint in artifact metadata for the install
         audit required by project memory. The open-source Host has no activation check. -->
    <AssemblyMetadata Include="PiuLinkProductionActivationUrl" Value="https://piulink.atipiu.org:8443" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embed shell artwork into the WPF assembly. The windows must remain
         launchable even if an installer upgrade omits or removes Assets. -->
    <Content Include="..\..\installers\licenses\NAudio-MIT.txt" Link="third_party\NAudio\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\PiuLink.ico" />
    <Resource Include="Assets\PiuLink-256.png" />
    <Resource Include="../../../../assets/brand/host-lunar-settings-sheet.png" Link="Assets/LunarSettings.png" />
  </ItemGroup>
  <PropertyGroup>
    <PiuLinkEngineDirectory Condition="'$(PiuLinkEngineDirectory)' == ''"></PiuLinkEngineDirectory>
  </PropertyGroup>
  <Target Name="ValidateEmbeddedEngine" BeforeTargets="PrepareForBuild" Condition="'$(PiuLinkEngineDirectory)' != ''">
    <Error Condition="!Exists('$(PiuLinkEngineDirectory)\PiuLink.Engine.exe') Or !Exists('$(PiuLinkEngineDirectory)\tools\PiuLink.Engine.Service.exe') Or !Exists('$(PiuLinkEngineDirectory)\piulink-engine.json')" Text="The embedded engine must be a complete staged PiuLink engine build." />
  </Target>
  <ItemGroup Condition="'$(PiuLinkEngineDirectory)' != ''">
    <Content Include="../../../../assets/brand/exports/windows/desktop*.png" Link="engine/assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PiuLinkEngineDirectory)\**\*" Exclude="$(PiuLinkEngineDirectory)\config\**;$(PiuLinkEngineDirectory)\-symbols\**;$(PiuLinkEngineDirectory)\**\*.log;$(PiuLinkEngineDirectory)\assets\desktop.png;$(PiuLinkEngineDirectory)\assets\desktop-alt.png" Link="engine\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(PiuLinkEngineDirectory)' != ''">
    <_EngineWebText Include="$(PiuLinkEngineDirectory)\assets\web\*.html" WebPath="%(Filename)%(Extension)" />
    <_EngineWebText Include="$(PiuLinkEngineDirectory)\assets\web\assets\Navbar-*.js" WebPath="assets\%(Filename)%(Extension)" />
    <_EngineWebText Include="$(PiuLinkEngineDirectory)\assets\web\assets\createLucideIcon-*.js" WebPath="assets\%(Filename)%(Extension)" />
    <_EngineWebText Include="$(PiuLinkEngineDirectory)\assets\web\assets\welcome-*.js" WebPath="assets\%(Filename)%(Extension)" />
    <_EngineWebText Include="$(PiuLinkEngineDirectory)\assets\web\assets\locale\*.json" WebPath="assets\locale\%(Filename)%(Extension)" />
    <Content Remove="@(_EngineWebText);$(PiuLinkEngineDirectory)\assets\web\images\logo-sunshine-*.png;$(PiuLinkEngineDirectory)\assets\web\images\sunshine.ico" />
    <Content Remove="$(PiuLinkEngineDirectory)\assets\web\images\sunshine-playing*;$(PiuLinkEngineDirectory)\assets\web\images\sunshine-pausing*;$(PiuLinkEngineDirectory)\assets\web\images\sunshine-locked*" />
    <Content Include="../../../../assets/brand/exports/windows/engine-tray/*" Link="engine/assets/web/images/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../../assets/brand/exports/web/piulink-16.png" Link="engine/assets/web/images/logo-sunshine-16.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../../assets/brand/exports/web/piulink-45.png" Link="engine/assets/web/images/logo-sunshine-45.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../../assets/brand/exports/windows/piulink-host.ico" Link="engine/assets/web/images/sunshine.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PrepareManagementWebBrand" BeforeTargets="AssignTargetPaths" Condition="'@(_EngineWebText)' != ''">
    <PropertyGroup>
      <_WebStage>$(IntermediateOutputPath)piulink-web</_WebStage>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\installers\Stage-WebBrand.ps1&quot; -WebRoot &quot;$(PiuLinkEngineDirectory)\assets\web&quot; -OutputDirectory &quot;$(_WebStage)&quot;" />
    <ItemGroup>
      <Content Include="$(_WebStage)\%(_EngineWebText.WebPath)" Link="engine\assets\web\%(_EngineWebText.WebPath)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup Condition="'$(PiuLinkEngineDirectory)' == ''">
    <Content Include="..\..\installers\manifests\sunshine-windows-x64.json"
             Link="third_party\sunshine\manifest.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\installers\licenses\Sunshine-GPL-3.0.txt"
             Link="third_party\sunshine\Sunshine-GPL-3.0.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\installers\licenses\Sunshine-NOTICE.md"
             Link="third_party\sunshine\Sunshine-NOTICE.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\installers\cache\Sunshine-Windows-AMD64-installer.msi"
             Condition="Exists('..\..\installers\cache\Sunshine-Windows-AMD64-installer.msi')"
             Link="third_party\sunshine\Sunshine-Windows-AMD64-installer.msi"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../../../packages/direct-tunnel/WindowsTransport.targets" />
  <Import Project="../../web-session/WebHost.targets" />
  <Import Project="../../../../packages/diagnostics/Diagnostics.targets" />
</Project>
