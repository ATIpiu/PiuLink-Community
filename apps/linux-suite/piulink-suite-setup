#!/usr/bin/env bash
set -euo pipefail
umask 077
if [[ $(id -u) == 0 ]]; then echo '请用自己的桌面账户运行此命令。' >&2; exit 1; fi
if [[ ${1:-} == --terminal ]]; then
    trap 'status=$?; echo; read -r -p "按回车关闭窗口 " _ || true; exit "$status"' EXIT
fi
. /etc/os-release
if [[ $ID != ubuntu || $VERSION_ID != 26.04 || $(uname -m) != x86_64 ]]; then
    echo 'PiuLink Linux 整合版的组件安装需要 Ubuntu 26.04 x64。' >&2
    exit 1
fi
base=${XDG_DATA_HOME:-$HOME/.local/share}/piulink-linux
mkdir -p "$base/runtime" "$base/downloads"
exec 8>"$base/downloads/suite-setup.lock"
flock -n 8 || { echo '已有组件安装正在进行。' >&2; exit 1; }
engine="$base/runtime/moonlight-6.2.0"
if ! command -v moonlight >/dev/null && [[ ! -x "$engine/AppRun" ]]; then
    install_moonlight() (
        stage=$(mktemp -d "$base/runtime/.moonlight-XXXXXX")
        trap 'rm -rf -- "$stage"' EXIT
        cd "$stage"
        curl -fL --retry 2 --connect-timeout 15 --max-time 480 -o Moonlight.AppImage \
          https://github.com/moonlight-stream/moonlight-qt/releases/download/v6.2.0/Moonlight-6.2.0-x86_64.AppImage
        printf '%s  %s\n' 787b0dcbd42ae90620e76fb8d77d7c441ba6473a91c2d7fc3a0fc2466f992437 Moonlight.AppImage | sha256sum -c
        chmod 700 Moonlight.AppImage
        ./Moonlight.AppImage --appimage-extract > extract.log
        test -x squashfs-root/AppRun
        mv -T squashfs-root "$engine"
    )
    install_moonlight
fi
/usr/bin/piulink-host-setup-user
printf '\n%s\n' '组件已准备好。控制端可从应用菜单打开。启用本机被控端时，在本账户运行以下两条命令：'
printf '%s\n' '  piulink-host setup desktop' '  systemctl --user enable --now piulink-host.service'
