        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="虚拟手柄 · 输入将发送到当前 Host" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
            <Button Content="隐藏" Click="HideVirtualGamepad_Click" HorizontalAlignment="Right" Padding="10,3" />
          </Grid>
          <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /><ColumnDefinition Width="155" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <Grid Height="38"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="LB" Tag="256" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" />
                <Button Grid.Column="2" Content="LT" Click="ResetLeftTrigger_Click" />
              </Grid>
              <Grid Width="126" Height="126" Margin="12,13,0,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="1" Content="▲" Tag="1" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" />
                <Button Grid.Row="1" Grid.Column="0" Content="◀" Tag="4" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" />
                <Button Grid.Row="1" Grid.Column="2" Content="▶" Tag="8" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" />
                <Button Grid.Row="2" Grid.Column="1" Content="▼" Tag="2" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" />
              </Grid>
              <Border x:Name="LeftStickPad" Width="112" Height="112" Margin="19,13,0,0" Background="{StaticResource ControlBrush}" BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="56" MouseLeftButtonDown="Stick_MouseLeftButtonDown" MouseMove="LeftStick_MouseMove" MouseLeftButtonUp="Stick_MouseLeftButtonUp" LostMouseCapture="LeftStick_LostMouseCapture">
                <Ellipse x:Name="LeftStickKnob" Width="34" Height="34" Fill="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Button Content="L3" Tag="64" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" Margin="30,8,30,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Width="170">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Back" Tag="32" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" Margin="0,0,8,0" />
                <Button Content="Start" Tag="16" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" />
              </StackPanel>
              <TextBlock Text="LT" Foreground="{StaticResource TextBrush}" Margin="0,15,0,2" HorizontalAlignment="Center" />
              <Slider x:Name="LeftTriggerSlider" Minimum="0" Maximum="255" ValueChanged="Trigger_ValueChanged" />
              <TextBlock Text="RT" Foreground="{StaticResource TextBrush}" Margin="0,12,0,2" HorizontalAlignment="Center" />
              <Slider x:Name="RightTriggerSlider" Minimum="0" Maximum="255" ValueChanged="Trigger_ValueChanged" />
              <Button Content="松开扳机" Click="ResetTriggers_Click" Margin="0,12,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <Grid Height="38"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="RB" Tag="512" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" />
                <Button Grid.Column="2" Content="RT" Click="ResetRightTrigger_Click" />
              </Grid>
              <Grid Width="126" Height="126" Margin="12,13,0,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="1" Content="Y" Tag="32768" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" />
                <Button Grid.Row="1" Grid.Column="0" Content="X" Tag="16384" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" />
                <Button Grid.Row="1" Grid.Column="2" Content="B" Tag="8192" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" />
                <Button Grid.Row="2" Grid.Column="1" Content="A" Tag="4096" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" />
              </Grid>
              <Border x:Name="RightStickPad" Width="112" Height="112" Margin="19,13,0,0" Background="{StaticResource ControlBrush}" BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="56" MouseLeftButtonDown="Stick_MouseLeftButtonDown" MouseMove="RightStick_MouseMove" MouseLeftButtonUp="Stick_MouseLeftButtonUp" LostMouseCapture="RightStick_LostMouseCapture">
                <Ellipse x:Name="RightStickKnob" Width="34" Height="34" Fill="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Button Content="R3" Tag="128" PreviewMouseLeftButtonDown="GamepadButton_Down" PreviewMouseLeftButtonUp="GamepadButton_Up" LostMouseCapture="GamepadButton_Up" Margin="30,8,30,0" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</Window>
