<Window x:Class="PiuLink.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PiuLink.Client"
        Title="PiuLink Client"
        Icon="Assets/PiuLink.ico"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="640"
        Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Grid Background="{StaticResource BackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="288" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="20,22,18,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
          <Image Source="Assets/PiuLink-256.png" Width="42" Height="42" Margin="0,0,12,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PiuLink" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Windows 客户端" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,26,0,10">
          <TextBlock Text="我的电脑" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DiscoverHostsButton" Content="发现" Padding="10,6" MinHeight="32" Click="DiscoverHosts_Click" Margin="0,0,6,0" />
            <Button Content="＋ 添加" Padding="11,6" MinHeight="32" Click="ShowAddHost_Click" />
          </StackPanel>
        </Grid>

        <ListBox x:Name="HostsList"
                 Grid.Row="2"
                 ItemsSource="{Binding Hosts}"
                 SelectionChanged="HostsList_SelectionChanged"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,2" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemSurface" Padding="13,11" CornerRadius="12" Background="{TemplateBinding Background}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource RaisedPanelBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                        <Setter TargetName="ItemSurface" Property="Effect">
                          <Setter.Value><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.05" /></Setter.Value>
                        </Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource ControlBrush}" VerticalAlignment="Center">
                  <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Address}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3">
          <Border x:Name="AddHostPanel" Visibility="Collapsed" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="14" Margin="0,10,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="添加电脑" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Text="仅保存在这台电脑上" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,10" />
              <TextBlock Text="显示名称" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="1,0,0,4" />
              <TextBox x:Name="HostNameInput" ToolTip="显示名称" Margin="0,0,0,8" />
              <TextBlock Text="邀请链接、IP 或主机名" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="1,0,0,4" />
              <TextBox x:Name="HostAddressInput" ToolTip="粘贴 Host 的直连邀请链接，也可输入 IP 或 Tailscale 地址" />
              <TextBlock x:Name="AddHostError" Foreground="{StaticResource ErrorBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" Visibility="Collapsed" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="取消" Padding="12,6" MinHeight="32" Click="CancelAddHost_Click" Margin="0,0,6,0" />
                <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" MinHeight="32" Click="SaveHost_Click" />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="32,26,32,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <StackPanel>
          <TextBlock Text="连接" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" />
          <TextBlock Text="选择电脑，打开桌面或应用。" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="打开 Tailscale" Click="OpenTailscale_Click" Margin="0,0,8,0" />
        </StackPanel>
      </Grid>

      <Border x:Name="EngineStatusBorder" Grid.Row="1" CornerRadius="11" Padding="12,9" Margin="0,18,0,16" Background="{StaticResource RaisedPanelBrush}">
        <Grid>
          <TextBlock x:Name="EngineStatusText" Text="正在检查串流内核…" FontSize="12" />
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Border x:Name="EmptyStatePanel" Style="{StaticResource CardStyle}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
            <Border Width="74" Height="74" CornerRadius="24" Background="{StaticResource ControlBrush}" HorizontalAlignment="Center">
              <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="31" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="添加你的第一台电脑" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,7" />
            <TextBlock Text="输入局域网 IP、Tailscale 地址或主机名。PiuLink 不会上传或同步这些信息。" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button Content="添加电脑" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0,20,0,0" Click="ShowAddHost_Click" />
          </StackPanel>
        </Border>

        <ScrollViewer x:Name="HostDetailPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,6,8">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                  <StackPanel>
                    <TextBlock x:Name="SelectedHostName" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Border x:Name="ConnectionKindBadge" HorizontalAlignment="Left" Background="{StaticResource ControlBrush}" CornerRadius="9" Padding="8,3" Margin="0,6,0,0">
                      <TextBlock x:Name="ConnectionKindText" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="SelectedHostAddress" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Ellipse x:Name="ReachabilityDot" Width="8" Height="8" Fill="{StaticResource SubtleBrush}" Margin="0,0,7,0" />
                    <TextBlock x:Name="ReachabilityText" Text="尚未检测" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                  </StackPanel>
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                  <Button x:Name="RefreshHostButton" Content="刷新" Click="RefreshHost_Click" Margin="0,0,8,0" />
                  <Button x:Name="PairHostButton" Content="配对" Click="PairHost_Click" Margin="0,0,8,0" />
                  <Button x:Name="WakeHostButton" Content="唤醒" Click="WakeHost_Click" Margin="0,0,8,0" IsEnabled="False" />
                  <ToggleButton x:Name="MoreHostActions" Content="更多操作" Style="{StaticResource DisclosureButton}" />
                </WrapPanel>
                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                  <WrapPanel.Style>
                    <Style TargetType="WrapPanel">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=MoreHostActions}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </WrapPanel.Style>
                  <Button x:Name="SshHostButton" Content="SSH 终端" Click="SshHost_Click" Margin="0,0,8,0" />
                  <Button x:Name="ToggleVirtualGamepadButton" Content="虚拟手柄" Click="ToggleVirtualGamepad_Click" Margin="0,0,8,0" IsEnabled="False" />
                  <Button Content="删除" Style="{StaticResource DangerButton}" Click="DeleteHost_Click" />
                </WrapPanel>
              </Grid>
            </Border>

            <Border x:Name="PairingPanel" Visibility="Collapsed" Background="{StaticResource WarningFillBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="在主机端输入这个 PIN" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                  <TextBlock Text="Qt Moonlight 正在等待；请在主机 Sunshine / PiuLink Host 的配对提示中手动输入此 PIN。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock x:Name="PairingPinText" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="27" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="22,0,4,0" />
              </Grid>
            </Border>

            <Grid x:Name="ContentColumns" SizeChanged="ContentColumns_SizeChanged">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ApplicationsColumn" Width="2*" />
                <ColumnDefinition x:Name="ColumnGap" Width="14" />
                <ColumnDefinition x:Name="SettingsColumn" Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <StackPanel>
                      <TextBlock Text="可用应用" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock x:Name="AppsHintText" TextWrapping="Wrap" Text="刷新主机后读取 Sunshine 应用列表。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                    <ProgressBar x:Name="RefreshProgress" IsIndeterminate="True" Width="90" Height="3" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                  </Grid>
                  <ItemsControl x:Name="AppsList" Grid.Row="1" ItemsSource="{Binding Applications}" Margin="0,17,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Tag="{Binding}" Click="StartApp_Click" Width="174" Height="82" Margin="0,0,10,10" Padding="13" HorizontalContentAlignment="Stretch">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="42" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource ControlBrush}" VerticalAlignment="Center">
                              <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource PrimaryBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="开始串流  ›" Foreground="{StaticResource PrimaryBrush}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>

              <Border x:Name="SettingsCard" Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Text="连接配置" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="此电脑的串流设置" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,4" />
                  <TextBlock x:Name="SettingsSaveStatus" Text="已保存；下次启动时使用这些参数。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,14" />

                  <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                      <TextBlock Text="主机显示器" Style="{StaticResource SettingsSectionTitle}" />
                      <ComboBox x:Name="HostDisplayCombo" Margin="0,10,0,0" />
                      <TextBlock Text="Windows 缩放" Style="{StaticResource SettingsLabel}" Margin="0,12,0,5" />
                      <ComboBox x:Name="DisplayScaleCombo" SelectedIndex="0">
                        <ComboBoxItem Content="保持 Windows 当前设置" Tag="0" />
                      </ComboBox>
                      <CheckBox x:Name="GatherWindowsCheckBox" Margin="0,10,0,0"><TextBlock Text="把窗口集中到这块物理屏幕" TextWrapping="Wrap" /></CheckBox>
                      <TextBlock x:Name="DisplayCapabilityHint" Text="连接主机后会显示可用屏幕和限制。" Style="{StaticResource SettingsHint}" Margin="1,6,0,0" />
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource SettingsSection}" Margin="0,10,0,0">
                    <StackPanel>
                      <TextBlock Text="画质与流畅度" Style="{StaticResource SettingsSectionTitle}" />
                      <TextBlock Text="分辨率" Style="{StaticResource SettingsLabel}" Margin="0,12,0,5" />
                      <ComboBox x:Name="ResolutionCombo" SelectedIndex="0">
                        <ComboBoxItem Content="1280 × 720" Tag="1280x720" />
                        <ComboBoxItem Content="1920 × 1080" Tag="1920x1080" />
                        <ComboBoxItem Content="2560 × 1440" Tag="2560x1440" />
                        <ComboBoxItem Content="3840 × 2160" Tag="3840x2160" />
                      </ComboBox>
                      <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="帧率" Style="{StaticResource SettingsLabel}" Margin="0,0,0,5" />
                          <ComboBox x:Name="FpsCombo" SelectedIndex="1">
                            <ComboBoxItem Content="30 fps" Tag="30" />
                            <ComboBoxItem Content="60 fps" Tag="60" />
                            <ComboBoxItem Content="90 fps" Tag="90" />
                            <ComboBoxItem Content="120 fps" Tag="120" />
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock x:Name="BitrateSettingLabel" Text="手动码率（仅手动模式）" Style="{StaticResource SettingsLabel}" Margin="0,0,0,5" />
                          <ComboBox x:Name="BitrateCombo" SelectedIndex="1">
                            <ComboBoxItem Content="10 Mbps" Tag="10000" />
                            <ComboBoxItem Content="20 Mbps" Tag="20000" />
                            <ComboBoxItem Content="40 Mbps" Tag="40000" />
                            <ComboBoxItem Content="80 Mbps" Tag="80000" />
                          </ComboBox>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Background="{StaticResource RaisedPanelBrush}" CornerRadius="11" Padding="11" Margin="0,10,0,0">
                    <TextBlock x:Name="ScreenStatusText" Text="刷新电脑以读取真实显示器和支持的模式。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                  </Border>
                  <Button x:Name="ApplySettingsButton" Content="应用并重连" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyAndReconnect_Click" Visibility="Collapsed" Margin="0,10,0,0" />
                  <Button x:Name="CancelPreparationButton" Content="取消连接" Click="CancelPreparation_Click" Visibility="Collapsed" Margin="0,10,0,0" />

                  <Expander Header="高级串流设置" Margin="0,14,0,0" Style="{StaticResource SettingsExpander}">
                    <StackPanel Margin="0,12,0,0">
                      <TextBlock Text="网络与显示" Style="{StaticResource SettingsSectionTitle}" />
                      <TextBlock Text="显示模式" Style="{StaticResource SettingsLabel}" Margin="0,10,0,5" />
                      <ComboBox x:Name="DisplayModeCombo" SelectedIndex="0">
                        <ComboBoxItem Content="全屏" Tag="fullscreen" />
                        <ComboBoxItem Content="无边框窗口" Tag="borderless" />
                        <ComboBoxItem Content="窗口" Tag="windowed" />
                      </ComboBox>
                      <TextBlock Text="视频编码" Style="{StaticResource SettingsLabel}" Margin="0,12,0,5" />
                      <ComboBox x:Name="CodecCombo" SelectedIndex="0">
                        <ComboBoxItem Content="自动（推荐）" Tag="auto" />
                        <ComboBoxItem Content="H.264" Tag="H.264" />
                        <ComboBoxItem Content="HEVC" Tag="HEVC" />
                        <ComboBoxItem Content="AV1" Tag="AV1" />
                      </ComboBox>
                      <TextBlock x:Name="CodecPolicyText" Text="自动选择会根据网络、分辨率和硬件能力决定。" Style="{StaticResource SettingsHint}" Margin="1,5,0,0" />
                      <CheckBox x:Name="AutoBitrateCheckBox" Content="启动时自动选择码率" IsChecked="True" Margin="0,12,0,0" FontSize="12" />
                      <TextBlock x:Name="AutoBitrateHintText" Text="连接前按分辨率和网络路径选择一次码率；串流中保持固定。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="18,3,0,0" />
                      <CheckBox x:Name="ContentAdaptiveCheckBox" Content="内容自适应压缩" IsChecked="False" Visibility="Collapsed" Margin="0,9,0,0" FontSize="12" />
                      <CheckBox x:Name="HdrCheckBox" Margin="0,9,0,0" FontSize="12"><TextBlock Text="启用 HDR（主机和显示器需支持）" TextWrapping="Wrap" FontSize="12" /></CheckBox>
                      <CheckBox x:Name="Yuv444CheckBox" Content="YUV 4:4:4 色彩采样（需要 Host 与硬解支持）" Margin="0,9,0,0" FontSize="12" />
                      <TextBlock Text="色彩范围" Style="{StaticResource SettingsLabel}" Margin="0,12,0,5" />
                      <ComboBox x:Name="ColorRangeCombo" SelectedIndex="0">
                        <ComboBoxItem Content="自动（推荐）" Tag="auto" />
                        <ComboBoxItem Content="有限范围（视频标准）" Tag="limited" />
                        <ComboBoxItem Content="完整范围（用于修正 OLED 黑位）" Tag="full" />
                      </ComboBox>

                      <TextBlock Text="音频" Style="{StaticResource SettingsSectionTitle}" Margin="0,18,0,0" />
                      <ComboBox x:Name="AudioConfigCombo" SelectedIndex="0" Margin="0,10,0,0">
                        <ComboBoxItem Content="立体声" Tag="stereo" />
                        <ComboBoxItem Content="5.1 环绕声" Tag="5.1-surround" />
                        <ComboBoxItem Content="7.1 环绕声" Tag="7.1-surround" />
                      </ComboBox>
                      <CheckBox x:Name="PlayAudioOnHostCheckBox" Content="主机也播放声音" Margin="0,9,0,0" FontSize="12" />
                      <CheckBox x:Name="MuteOnFocusLossCheckBox" Content="窗口失去焦点时静音" Margin="0,9,0,0" FontSize="12" />

                      <TextBlock Text="输入与帧节奏" Style="{StaticResource SettingsSectionTitle}" Margin="0,18,0,0" />
                      <CheckBox x:Name="DesktopMouseCheckBox" Content="桌面优化鼠标模式" IsChecked="True" Margin="0,10,0,0" FontSize="12" />
                      <CheckBox x:Name="VsyncCheckBox" Content="垂直同步" IsChecked="True" Margin="0,9,0,0" FontSize="12" />
                      <CheckBox x:Name="FramePacingCheckBox" Content="帧节奏控制（降低抖动，可能增加延迟）" Margin="0,9,0,0" FontSize="12" />
                      <CheckBox x:Name="MultiControllerCheckBox" Content="允许多个本地手柄" IsChecked="True" Margin="0,9,0,0" FontSize="12" />
                      <TextBlock Text="摇杆死区" Style="{StaticResource SettingsLabel}" Margin="0,12,0,5" />
                      <ComboBox x:Name="GamepadDeadzoneCombo" SelectedIndex="2">
                        <ComboBoxItem Content="0%（关闭）" Tag="0" />
                        <ComboBoxItem Content="3%（轻微）" Tag="3" />
                        <ComboBoxItem Content="7%（推荐）" Tag="7" />
                        <ComboBoxItem Content="10%" Tag="10" />
                        <ComboBoxItem Content="15%" Tag="15" />
                        <ComboBoxItem Content="20%" Tag="20" />
                      </ComboBox>
                      <CheckBox x:Name="BackgroundGamepadCheckBox" Content="失焦后仍接收手柄输入" Margin="0,9,0,0" FontSize="12" />
                      <CheckBox x:Name="SwapGamepadFaceButtonsCheckBox" Content="交换手柄 A/B 与 X/Y（任天堂布局）" Margin="0,9,0,0" FontSize="12" />
                      <CheckBox x:Name="VirtualGamepadEnabledCheckBox" Content="串流时显示虚拟手柄（触屏 / 鼠标）" Margin="0,9,0,0" FontSize="12" />
                      <TextBlock Text="系统快捷键" Style="{StaticResource SettingsLabel}" Margin="0,12,0,5" />
                      <ComboBox x:Name="CaptureSystemKeysCombo" SelectedIndex="1">
                        <ComboBoxItem Content="从不捕获" Tag="never" />
                        <ComboBoxItem Content="全屏时捕获（推荐）" Tag="fullscreen" />
                        <ComboBoxItem Content="始终捕获" Tag="always" />
                      </ComboBox>

                      <TextBlock Text="诊断" Style="{StaticResource SettingsSectionTitle}" Margin="0,18,0,0" />
                      <CheckBox x:Name="PerformanceOverlayCheckBox" Content="在串流画面显示性能数据（调试）" IsChecked="True" Margin="0,10,0,0" FontSize="12" />
                      <Border Background="{StaticResource RaisedPanelBrush}" CornerRadius="11" Padding="11" Margin="0,10,0,0">
                        <StackPanel>
                          <TextBlock Text="实时性能" FontWeight="SemiBold" FontSize="12" />
                          <TextBlock x:Name="PerformanceText" Text="开始串流后显示视频实收带宽、动态目标、Host 目标与网络质量。实收带宽不等于链路空闲容量。" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                      </Border>
                      <Button Content="查看客户端日志" Click="ViewLogs_Click" Margin="0,12,0,0" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border x:Name="StreamOverlay" Grid.ColumnSpan="2" Background="#FF050505" Visibility="Collapsed" Panel.ZIndex="100">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="14,9">
          <Grid>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
              <TextBlock x:Name="StreamTitleText" Text="PiuLink Desktop" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
              <TextBlock x:Name="StreamFrameText" Text=" · 正在连接" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
            </StackPanel>
            <Button Content="断开" HorizontalAlignment="Right" Click="DisconnectStream_Click" Padding="16,5" />
          </Grid>
        </Border>
        <local:EmbeddedStreamSurface Grid.Row="1" x:Name="StreamSurface" Focusable="True" />
      </Grid>
    </Border>
    <Popup x:Name="VirtualGamepadOverlay" IsOpen="False" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" Placement="Center">
