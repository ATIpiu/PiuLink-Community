<Window x:Class="PiuLink.Client.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PiuLink 客户端日志" Width="900" Height="620" MinWidth="620" MinHeight="420"
        Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="客户端日志" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="显示最近 256 KiB。点击“打开目录”可查看完整日志。" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,14" />
      </StackPanel>
      <WrapPanel Grid.Row="1" Margin="0,0,0,12">
        <Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,0" />
        <Button Content="复制" Click="Copy_Click" Margin="0,0,8,0" />
        <Button Content="打开目录" Click="OpenFolder_Click" Margin="0,0,8,0" />
        <Button Content="上传连接与崩溃日志" Click="Upload_Click" Margin="0,0,8,0" />
        <Button Content="清空" Click="Clear_Click" />
      </WrapPanel>
    </Grid>
    <TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             FontFamily="Cascadia Mono, Consolas" FontSize="12" />
  </Grid>
</Window>
