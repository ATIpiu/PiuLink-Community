+void SdlInputHandler::sendVirtualGamepadState(int buttons, short lsX, short lsY, short rsX, short rsY,
+                                              unsigned char lt, unsigned char rt)
+{
+    applyGamepadDeadzone(lsX, lsY);
+    applyGamepadDeadzone(rsX, rsY);
+    // The WPF touch overlay sends the canonical Xbox layout. Apply the same
+    // user preference as physical SDL controllers before the packet reaches
+    // the Host, so a Nintendo-labelled controller behaves consistently.
+    if (m_SwapFaceButtons) {
+        const int faceButtons = buttons & (A_FLAG | B_FLAG | X_FLAG | Y_FLAG);
+        buttons &= ~(A_FLAG | B_FLAG | X_FLAG | Y_FLAG);
+        if (faceButtons & A_FLAG) buttons |= B_FLAG;
+        if (faceButtons & B_FLAG) buttons |= A_FLAG;
+        if (faceButtons & X_FLAG) buttons |= Y_FLAG;
+        if (faceButtons & Y_FLAG) buttons |= X_FLAG;
+    }
+    // Slot zero is Moonlight's conventional first controller. Keep the
+    // virtual source visible to the Host even when no physical SDL controller
+    // is attached. Physical controllers continue to use their normal slots.
+    const uint16_t mask = static_cast<uint16_t>(m_GamepadMask | 0x1);
+    if (!m_VirtualGamepadAnnounced) {
+        const uint32_t supportedButtons = A_FLAG | B_FLAG | X_FLAG | Y_FLAG |
+            BACK_FLAG | SPECIAL_FLAG | PLAY_FLAG | LS_CLK_FLAG | RS_CLK_FLAG |
+            LB_FLAG | RB_FLAG | UP_FLAG | DOWN_FLAG | LEFT_FLAG | RIGHT_FLAG;
+        LiSendControllerArrivalEvent(0, mask, LI_CTYPE_XBOX, supportedButtons, LI_CCAP_ANALOG_TRIGGERS);
+        m_VirtualGamepadAnnounced = true;
+    }
+    LiSendMultiControllerEvent(0, mask, buttons, lt, rt, lsX, lsY, rsX, rsY);
+}
+
+void SdlInputHandler::applyGamepadDeadzone(short& x, short& y) const
+{
+    if (m_GamepadDeadzonePercent == 0) {
+        return;
+    }
+
+    const qint64 threshold = 32767LL * m_GamepadDeadzonePercent / 100;
+    const qint64 magnitudeSquared = static_cast<qint64>(x) * x + static_cast<qint64>(y) * y;
+    if (magnitudeSquared <= threshold * threshold) {
+        x = 0;
+        y = 0;
+    }
+}
