@@ -0,0 +1,17 @@
+#pragma once
+
+#include "video/decoder.h"
+
+void PiuLinkBridgeStart(int initialBitrateKbps);
+void PiuLinkBridgeStop();
+void PiuLinkBridgeAddReceivedBytes(int bytes);
+void PiuLinkBridgePublishVideoStats(const VIDEO_STATS& stats, int videoFormat);
+
+struct PiuLinkBridgeNetworkStats {
+    int receivedKbps;
+    int historicalKbps;
+    int targetKbps;
+    int appliedKbps;
+    int ceilingKbps;
+};
+PiuLinkBridgeNetworkStats PiuLinkBridgeGetNetworkStats();
