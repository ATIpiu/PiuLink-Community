# Copy this file to keystore.properties for local documentation only.
# Do not commit real credentials. Prefer passing the matching Gradle properties
# from a user-level Gradle configuration or the PIULINK_UPLOAD_* environment variables.
piulinkUploadStoreFile=C:/secure/location/piulink-upload.jks
piulinkUploadStorePassword=replace-me
piulinkUploadKeyAlias=piulink-upload
piulinkUploadKeyPassword=replace-me
