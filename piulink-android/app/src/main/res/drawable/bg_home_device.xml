<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <gradient android:startColor="@color/home_device_start" android:endColor="@color/home_device_end" android:angle="0" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/piulink_surface" />
            <stroke android:width="1dp" android:color="@color/home_line" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
