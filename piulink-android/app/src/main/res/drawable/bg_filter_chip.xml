<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/piulink_surface_pressed" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/piulink_blue_soft" />
            <stroke android:width="3dp" android:color="@color/piulink_focus" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/piulink_blue_soft" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/piulink_surface_secondary" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
