<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <!--
      Keep device-specific settings, pairing identities, host addresses, and
      certificates out of both cloud backup and device-to-device transfer.
  -->
  <cloud-backup disableIfNoEncryptionCapabilities="true">
    <exclude domain="sharedpref" path="."/>
    <exclude domain="file" path="client.key"/>
    <exclude domain="file" path="client.crt"/>
    <exclude domain="file" path="uniqueid"/>
    <exclude domain="database" path="."/>
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="file" path="client.key"/>
    <exclude domain="file" path="client.crt"/>
    <exclude domain="file" path="uniqueid"/>
    <exclude domain="database" path="."/>
  </device-transfer>
</data-extraction-rules>
