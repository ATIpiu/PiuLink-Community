<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_grid_card"
    android:elevation="2dp"
    android:focusable="false"
    android:gravity="center_horizontal"
    android:minHeight="@dimen/pc_grid_item_min_height"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/grid_image_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pc_grid_card_height"
        android:background="@drawable/bg_host_icon_surface">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="@dimen/pc_grid_icon_size"
            android:layout_height="@dimen/pc_grid_icon_size"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:tint="@color/piulink_blue" />

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:padding="6dp" />

        <ProgressBar
            android:id="@+id/grid_spinner"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/piulink_blue" />
    </FrameLayout>

    <TextView
        android:id="@+id/grid_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="start"
        android:maxLines="1"
        android:textColor="@color/piulink_text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/grid_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="1"
        android:textColor="@color/piulink_text_secondary"
        android:textSize="12sp" />
    <Button
        android:id="@+id/pcOpenDesktop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_primary_icon_button"
        android:focusable="false"
        android:text="@string/pc_open_desktop"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:visibility="gone" />
</LinearLayout>
