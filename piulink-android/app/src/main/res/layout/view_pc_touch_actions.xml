<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pcActions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical">
    <Button
        android:id="@+id/pcOpenDesktop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_desktop"
        android:focusable="false"
        android:minHeight="48dp"
        android:minWidth="104dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:stateListAnimator="@null"
        android:text="@string/pc_open_desktop"
        android:textAllCaps="false"
        android:textColor="@color/home_desktop_text"
        android:fontFamily="sans-serif-medium"
        android:textSize="15sp" />
    <Button
        android:id="@+id/pcSuperScreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="48dp"
        android:focusable="false"
        android:background="@drawable/bg_home_desktop"
        android:stateListAnimator="@null"
        android:text="@string/pc_super_screen"
        android:textColor="@color/home_desktop_text"
        android:textSize="15sp"
        android:textAllCaps="false" />
    <Button
        android:id="@+id/pcOpenLibrary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="start|center_vertical"
        android:drawableStart="@drawable/ic_computer"
        android:drawableTint="@color/home_muted"
        android:drawablePadding="10dp"
        android:focusable="false"
        android:minHeight="48dp"
        android:minWidth="88dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:stateListAnimator="@null"
        android:text="@string/home_apps"
        android:textAllCaps="false"
        android:textColor="@color/home_ink"
        android:textSize="14sp" />
</LinearLayout>
