<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Game" >

    <View
        android:id="@+id/backgroundTouchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <com.limelight.ui.StreamView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:focusedByDefault="true"
        android:nextFocusLeft="@id/streamMenuHandle"
        android:nextFocusRight="@id/shortcutRailHandle"
        android:defaultFocusHighlightEnabled="false">
        <requestFocus />
    </com.limelight.ui.StreamView>

    <ImageView
        android:id="@+id/touchpadLocalCursor"
        android:layout_width="18dp"
        android:layout_height="24dp"
        android:layout_gravity="top|left"
        android:importantForAccessibility="no"
        android:visibility="gone"
        android:src="@drawable/ic_touchpad_pointer" />

    <TextView
        android:id="@+id/performanceOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:textColor="#FF00FF66"
        android:textSize="11sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeMaxTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:gravity="top|left"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:background="@android:color/transparent"
        android:shadowColor="#FF000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="1"
        android:clickable="false"
        android:focusable="false"
        android:preferKeepClear="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/notificationOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="right"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:gravity="right"
        android:background="#80000000"
        android:preferKeepClear="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/remoteMicBadge"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_remote_mic_badge"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/bottomShortcutBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/bg_shortcut_rail"
        android:elevation="8dp"
        android:focusable="false"
        android:scrollbars="horizontal"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/bottomShortcutKeys"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp" />
    </HorizontalScrollView>

    <View
        android:id="@+id/streamOverlayScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#3D000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/streamMenuPanel"
        android:layout_width="@dimen/stream_menu_fallback_width"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_stream_menu_panel"
        android:clipToPadding="false"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/streamMenuTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/stream_menu_title"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/remoteMicDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="#FFE5EFF5"
            android:textSize="14sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/streamMenuScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:focusable="false">
            <LinearLayout
                android:id="@+id/streamMenuItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <ScrollView
        android:id="@+id/shortcutRail"
        android:layout_width="@dimen/shortcut_rail_fallback_width"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_shortcut_rail"
        android:clipToPadding="false"
        android:elevation="12dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp"
        android:scrollbars="none"
        android:visibility="gone">

        <GridLayout
            android:id="@+id/shortcutRailItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:useDefaultMargins="false" />
    </ScrollView>

    <include layout="@layout/view_shortcut_handle" />

    <TextView
        android:id="@+id/streamMenuHandle"
        android:layout_width="@dimen/stream_edge_handle_width"
        android:layout_height="@dimen/stream_edge_handle_height"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/stream_menu_handle_touch"
        android:clickable="true"
        android:contentDescription="@string/stream_menu_open"
        android:elevation="10dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:nextFocusRight="@id/surfaceView"
        android:text="›"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp" />

</merge>
