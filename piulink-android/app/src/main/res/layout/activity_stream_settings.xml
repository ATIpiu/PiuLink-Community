<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/piulink_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/piulink_toolbar_height" android:gravity="center_vertical" android:paddingStart="@dimen/piulink_page_margin" android:paddingEnd="@dimen/piulink_page_margin">
  <ImageButton android:id="@+id/settings_back" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_button" android:src="@drawable/ic_back" android:padding="12dp" android:contentDescription="@string/navigate_back" />
  <TextView android:id="@+id/settings_section_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:textSize="24sp" android:fontFamily="sans-serif-medium" android:textColor="@color/piulink_text_primary" />
 </LinearLayout>
 <ScrollView android:id="@+id/settings_tab_scroller" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:paddingStart="@dimen/piulink_page_margin" android:paddingEnd="@dimen/piulink_page_margin">
  <LinearLayout android:id="@+id/settings_sections" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp" />
 </ScrollView>
 <FrameLayout android:id="@+id/settings_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="12dp" android:background="@drawable/bg_settings_panel">
  <FrameLayout android:id="@+id/stream_settings" android:layout_width="match_parent" android:layout_height="match_parent" />
 </FrameLayout>
</LinearLayout>
