<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/app_grid_column_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_grid_card"
    android:elevation="2dp"
    android:focusable="false"
    android:gravity="center_horizontal"
    android:minHeight="228dp"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="@dimen/app_grid_poster_width"
        android:layout_height="@dimen/app_grid_poster_height"
        android:background="@drawable/bg_poster_surface">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_poster_surface"
            android:contentDescription="@null"
            android:cropToPadding="false"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_play_overlay"
            android:contentDescription="@null"
            android:padding="14dp"
            android:src="@drawable/ic_play"
            android:tint="@android:color/white" />

        <ImageView
            android:id="@+id/grid_favorite"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="7dp"
            android:background="@drawable/bg_favorite_badge"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_star_filled"
            android:tint="@android:color/white"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/grid_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/piulink_text_primary"
        android:textSize="14sp" />
</LinearLayout>
