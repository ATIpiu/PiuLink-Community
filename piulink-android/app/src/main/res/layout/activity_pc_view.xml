<?xml version="1.0" encoding="utf-8"?>
<!-- Phone portrait: common actions are explicit and remain comfortable on narrow screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".PcView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/piulink_surface"
        android:elevation="3dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/piulink_toolbar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_logo_mark"
                android:contentDescription="@string/piulink_home_title"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_piulink_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/piulink_home_title"
                    android:textColor="@color/piulink_text_primary"
                    android:textSize="19sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/piulink_home_subtitle"
                    android:textColor="@color/piulink_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/manuallyAddPc"
                android:layout_width="@dimen/piulink_touch_target"
                android:layout_height="@dimen/piulink_touch_target"
                android:background="@drawable/bg_primary_icon_button"
                android:contentDescription="@string/add_host"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_add"
                android:tint="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/settingsButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/piulink_touch_target"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:contentDescription="@string/open_settings"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/piulink_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/settings_label"
                    android:textColor="@color/piulink_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/terminalButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/piulink_touch_target"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:contentDescription="@string/ssh_title"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_terminal"
                    android:tint="@color/piulink_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/ssh_title"
                    android:textColor="@color/piulink_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tailscaleButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/piulink_touch_target"
                android:layout_marginStart="8dp"
                android:layout_weight="1.35"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:contentDescription="@string/open_tailscale"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_private_network"
                    android:tint="@color/piulink_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/private_network_label"
                    android:textColor="@color/piulink_blue"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:background="@drawable/bg_empty_state"
            android:elevation="2dp"
            android:gravity="center"
            android:orientation="vertical"
            tools:ignore="UselessParent">
            <!-- This overlay intentionally shares the fragment container and is toggled by PcView. -->

            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/piulink_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/looking_for_host_title"
                android:textColor="@color/piulink_text_primary"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/searching_pc"
                android:textColor="@color/piulink_text_secondary"
                android:textSize="14sp" />

            <include layout="@layout/view_setup_steps" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
