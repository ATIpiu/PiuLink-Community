<com.limelight.piulink.FeaturedSettingView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailFeatured" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_detail_feature" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="126dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.14" android:orientation="vertical"
            android:paddingStart="7dp" android:paddingEnd="3dp" android:paddingVertical="8dp">
            <TextView android:id="@android:id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:textColor="#55544E" android:textSize="13sp" />
            <TextView android:id="@+id/detailFeatureValue" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:textColor="#191B1B" android:textSize="27sp" android:layout_marginTop="5dp" />
            <TextView android:id="@+id/detailFeatureDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:textSize="13sp" android:textColor="#585952" />
        </LinearLayout>
        <ImageView android:id="@+id/detailFeatureImage" android:layout_width="0dp" android:layout_height="@dimen/detail_instrument_height"
            android:layout_weight="1" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    </LinearLayout>
    <com.limelight.piulink.QualityModeBar android:id="@+id/detailModeBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:orientation="horizontal" android:baselineAligned="false" android:padding="3dp"
        android:background="@drawable/bg_detail_modes" />
</com.limelight.piulink.FeaturedSettingView>
