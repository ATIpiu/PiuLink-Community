<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <FrameLayout
        android:id="@+id/grid_image_layout"
        android:layout_width="40dp"
        android:layout_height="40dp">
        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:importantForAccessibility="no" />
        <ProgressBar
            android:id="@+id/grid_spinner"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/piulink_blue" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/home_ink"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/grid_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawablePadding="6dp"
            android:textColor="@color/home_muted"
            android:textSize="13sp" />
    </LinearLayout>
    <Button
        android:id="@+id/pcSavedInvite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="48dp"
        android:layout_marginStart="8dp"
        android:focusable="false"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_home_add"
        android:text="@string/route_invitation"
        android:textAllCaps="false"
        android:textColor="@color/home_ink"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
