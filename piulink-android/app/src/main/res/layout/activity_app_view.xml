<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AppView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/piulink_toolbar_height"
        android:background="@color/piulink_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/appBackButton"
            android:layout_width="@dimen/piulink_touch_target"
            android:layout_height="@dimen/piulink_touch_target"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/navigate_back"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:tint="@color/piulink_text_primary" />

        <ImageView
            android:id="@+id/appBrandMark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_logo_mark"
            android:contentDescription="@string/piulink_home_title"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_piulink_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appListText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/piulink_text_primary"
                android:textSize="20sp"
                tools:text="Living room PC" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:id="@+id/appLibrarySubtitle"
                android:text="@string/piulink_apps_subtitle"
                android:textColor="@color/piulink_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/libraryFileAccess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingHorizontal="11dp"
            android:background="@drawable/bg_library_access"
            android:textColor="@color/piulink_text_primary"
            android:textSize="12sp"
            android:focusable="true"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
        <ImageButton
            android:id="@+id/appLibraryTools"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/lunar_library_tools"
            android:src="@drawable/ic_search"
            android:tint="@color/piulink_text_primary"
            android:visibility="gone" />
    </LinearLayout>

    <include layout="@layout/view_library_controls" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/appFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/appEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/bg_empty_state"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/appEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/library_empty_title"
                android:textColor="@color/piulink_text_primary"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/appEmptyMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/library_empty_message"
                android:textColor="@color/piulink_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
