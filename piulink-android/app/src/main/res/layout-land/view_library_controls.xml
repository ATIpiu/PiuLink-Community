<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <EditText
        android:id="@+id/appSearchInput"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1.3"
        android:background="@drawable/bg_text_field"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:hint="@string/search_library_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:singleLine="true"
        android:textColor="@color/piulink_text_primary"
        android:textColorHint="@color/piulink_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/filterAllButton"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_weight="0.55"
        android:background="@drawable/bg_filter_chip"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/library_filter_all"
        android:textColor="@color/filter_chip_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/filterFavoritesButton"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:layout_weight="0.7"
        android:background="@drawable/bg_filter_chip"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/library_filter_favorites"
        android:textColor="@color/filter_chip_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/filterRecentButton"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:layout_weight="0.6"
        android:background="@drawable/bg_filter_chip"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/library_filter_recent"
        android:textColor="@color/filter_chip_text"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/runningAppBanner"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1.1"
        android:background="@drawable/bg_running_banner"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/runningAppName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:drawableStart="@drawable/ic_play"
            android:drawablePadding="8dp"
            android:drawableTint="@color/piulink_success"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/piulink_text_primary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
