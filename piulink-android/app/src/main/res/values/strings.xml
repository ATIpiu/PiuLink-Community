    <string name="title_content_adaptive_encoding">Performance optimization</string>
    <string name="summary_content_adaptive_encoding">Automatically adjusts encoding load for static and moving content to save bandwidth while restoring motion quality quickly.</string>
    <string name="title_smart_display">Automatically match this phone</string>
    <string name="summary_smart_display">New connections use this phone’s physical resolution. Turn this off to use Default resolution below. A virtual display choice in Display settings takes priority.</string>
    <string name="title_save_metered_data">Save data on metered networks</string>
    <string name="summary_save_metered_data">When auto bitrate is enabled, cap metered connections at 10 Mbps. Leave this off to optimize for quality.</string>
