    <string name="category_basic_settings">Basic Settings</string>
    <string name="title_resolution_list">Default resolution (manual mode)</string>
    <string name="summary_resolution_list">Used only when automatic screen matching is off. A per-session virtual display choice in Display settings takes priority.</string>
    <string name="title_native_res_dialog">Native Resolution Warning</string>
    <string name="text_native_res_dialog">Native resolution and/or FPS may not be supported by the streaming server. You will probably need to configure a matching custom display mode for the host PC manually.\n\nIf you choose to create a custom resolution in NVIDIA Control Panel to match your screen settings, please ensure you have read and understood NVIDIA\'s warning regarding possible monitor damage, PC instability, and other potential problems.\n\nWe are not responsible for any problems resulting from creating a custom resolution on your PC.\n\nIt may be that your monitor does not support a necessary display configuration. If so, you may try to set up a virtual monitor. Finally, if your device or host PC does not support streaming at a specific resolution or refresh rate, you\'re out of luck unfortunately.</string>
    <string name="title_fps_list">Default stream frame rate</string>
    <string name="summary_fps_list">Used for new connections. A virtual display frame rate selected in Display settings takes priority.</string>
    <string name="title_seekbar_bitrate">Video bitrate</string>
    <string name="summary_seekbar_bitrate">Increase for better image quality. Decrease to improve performance on slower connections.</string>
    <string name="suffix_seekbar_bitrate_mbps">Mbps</string>
    <string name="title_auto_bitrate">Automatic bitrate</string>
    <string name="summary_auto_bitrate">Selects the initial rate and physical screen stream mode for remote connections. Compatible hosts reduce the rate on frame loss and raise it as demand and network conditions allow.</string>
    <string name="title_auto_bitrate_mode">Automatic bitrate preference</string>
    <string name="summary_auto_bitrate_mode">Choose a higher initial quality target or more conservative network headroom.</string>
