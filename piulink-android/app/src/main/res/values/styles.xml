<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppBaseThemeBase" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/piulink_background</item>
        <item name="android:colorBackground">@color/piulink_background</item>
        <item name="android:colorAccent">@color/piulink_blue</item>
        <item name="android:colorButtonNormal">@color/piulink_surface_secondary</item>
        <item name="android:textColorPrimary">@color/piulink_text_primary</item>
        <item name="android:textColorSecondary">@color/piulink_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@color/piulink_background</item>
        <item name="android:navigationBarColor">@color/piulink_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:buttonStyle">@style/LunarButton</item>
    </style>

    <style name="AppBaseTheme" parent="AppBaseThemeBase" />
    <style name="LunarButton" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <item name="android:alertDialogTheme">@style/PiuLinkDialogTheme</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/piulink_background</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:colorAccent">@color/piulink_blue</item>
    </style>

    <style name="StreamBaseTheme" parent="AppBaseTheme">
        <!-- Transparent streaming background to avoid extra overdraw -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Stream activity theme -->
    <style name="StreamTheme" parent="StreamBaseTheme">
        <item name="android:alertDialogTheme">@style/PiuLinkDialogTheme</item>
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="PiuLinkDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_surface</item>
        <item name="android:colorAccent">@color/piulink_blue</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/piulink_text_primary</item>
        <item name="android:textColorSecondary">@color/piulink_text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/piulink_text_primary</item>
        <item name="android:selectableItemBackground">@drawable/bg_dialog_choice</item>
        <item name="android:windowMinWidthMajor">70%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowElevation">8dp</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PiuLinkDialogPrimary</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/PiuLinkDialogSecondary</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/PiuLinkDialogSecondary</item>
        <item name="android:windowAnimationStyle">@style/PiuLinkDialogAnimation</item>
    </style>
    <style name="PiuLinkTouchDialogTheme" parent="PiuLinkDialogTheme">
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>
    <style name="PiuLinkDialogSecondary" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/piulink_blue</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
    <style name="PiuLinkDialogPrimary" parent="PiuLinkDialogSecondary">
        <item name="android:textColor">@color/piulink_on_accent</item>
        <item name="android:background">@drawable/bg_dialog_primary</item>
    </style>
    <style name="LunarDockAction" parent="@android:style/Widget.Material.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/piulink_text_primary</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="PiuLinkDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
</resources>
